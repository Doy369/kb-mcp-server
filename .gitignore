# secrets
.env
runtime_config.json

# local persistence (memory store dump; contains ingested KB content)
kb_store.json
kb_store_demo.json

# 知识图谱持久化（memory 图后端）+ demo 产物
kb_graph.json
kb_graph_demo.json

# 评测产物（每次重跑重新生成；报告本身入库以便前后对比）
kb_store_eval.json
kb_graph_eval.json

# python
__pycache__/
*.pyc
.venv/
venv/

# deps cache
*.egg-info/

# runtime logs
*.log

# P1-5 审计日志（只追加，内容含问答记录，不入库）
kb_audit.jsonl

# P2-9 动作审计日志（只追加，内容含动作参数与业务结果，不入库）
kb_actions.jsonl

# P1-4 协作联调脚本的本地持久化产物（含摄取的知识内容，不入库）
kb_store_collab.json
kb_graph_collab.json

# 规模化召回评测：嵌入缓存与中间产物（报告 bench_report_*.json 入库便于对比）
bench_emb_*.npz
*.tmp
kb_graph_bench.json
kb_store_bench.json

# PyInstaller build artifacts (exe 二进制不进仓库)
build/
dist/
*.spec
kb-mcp-server.exe
exe_test.log
.eval_runtime/

# P2-10 校验脚本产物
#   · 运行时隔离目录（各脚本独立数据目录，避免互相看到对方的 store）
#   · 报告不入库：它们记录的是「那一次机器上的数字」，与环境强相关，
#     入库会让「基线没变差」这件事被无关的机器差异污染；
#     真正要长期对比的是 eval_report.json（口径固定、可复现）。
.age_runtime/
.load_runtime/
load_report.json
age_report.json
eval_report_bge.json

# P0-2 实时适配器联调脚本产物
#   · 真实本地 HTTP 替身后端 + 真实 app 子进程所需的隔离数据目录
#   · 报告不入库（同 load/age 口径：记录的是「那一次机器上的数字」）
.adapters_live_runtime/
adapters_live_report.json

# P1-4 收尾：协作链路联调脚本产物（同上，报告只作 CI artifact）
.collab_runtime/
collaboration_report.json
