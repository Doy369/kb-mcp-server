# ===== 存储后端 =====
# pgvector：生产，需 Postgres+pgvector（填下面的 KB_DATABASE_URL）
# memory  ：本地离线开发，纯 Python 内存向量库，零依赖，无需 Postgres
KB_STORAGE_BACKEND=memory

# Postgres + pgvector 连接串（仅 pgvector 模式需要）
KB_DATABASE_URL=postgresql://kb:kb@localhost:5432/kb

# ===== 知识图谱（P6 · GraphRAG 关系增强层）=====
# memory：纯 Python 内存图 + JSON 落盘（kb_graph.json），离线零依赖
# age   ：Postgres + Apache AGE，与 pgvector 同库；不可用时自动回退 memory
KB_GRAPH_BACKEND=memory
# 总开关：摄取时是否自动抽取三元组入图（1=开）
KB_GRAPH_ENABLED=1
# AGE 模式下的图名（python setup_db.py --graph 会创建）
KB_GRAPH_NAME=kb_graph

# ===== 多 agent 协作（P7）=====
# deterministic（默认）：固定流水线编排，零 LLM 依赖，离线可跑
# llm             ：本地 LLM 参与路由（判断要不要查图/查实时数据），失败自动回退 deterministic
KB_AGENT_MODE=deterministic
# 问答前是否让 GraphBuilder agent 增量补图（1=开，幂等，已入图的文档会跳过）
KB_AGENT_BUILD_GRAPH=1

# ===== 嵌入后端 =====
# bge ：sentence-transformers 本地模型（BAAI/bge-large-zh-v1.5），语义召回强，数据不出域
# dev ：纯 Python 离线条目哈希嵌入，仅开发验证用（语义能力有限）
KB_EMBEDDING_BACKEND=dev
KB_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
KB_EMBEDDING_DIM=1024

# ===== 本地合成 LLM（OpenAI 兼容接口，如 Ollama / vLLM）=====
KB_LLM_BASE_URL=http://localhost:11434/v1
KB_LLM_MODEL=qwen2.5:7b

# ===== 外部 API 适配器（P4，实时数据接入 · 生产就绪）=====
# 1/true 强制 mock（默认 1）：未配置真实 endpoint 时返回样例数据，离线即可演示
# 配了真实地址后，必须设 KB_API_MOCK=0 才会走真实 HTTP 调用
KB_API_MOCK=1

# 鉴权（三选一，作用于所有适配器）：
#   scheme=bearer  -> 请求头 Authorization: Bearer <KEY>（默认）
#   scheme=header  -> 自定义请求头，配合 KB_API_AUTH_HEADER（如 x-api-key）
#   scheme=query   -> 查询参数，配合 KB_API_AUTH_QUERY（如 token）
KB_API_KEY=
KB_API_AUTH_SCHEME=bearer
KB_API_AUTH_HEADER=Authorization
KB_API_AUTH_QUERY=
KB_API_TIMEOUT=5      # 单次请求超时（秒）
KB_API_TTL=30         # 实时数据缓存时长（秒），避免频繁打后端

# ---- 订单状态适配器 ----
KB_ORDER_API_URL=          # 基址，如 http://order-svc.internal
KB_ORDER_PATH_TPL=/orders/{id}        # 路径模板，{id} 替换为订单号
KB_ORDER_STATUS_PATH=status          # 响应里「状态」字段的 JSON 路径（支持 data.x[0].y）
KB_ORDER_CARRIER_PATH=carrier        # 响应里「承运商」字段路径
KB_ORDER_ETA_PATH=eta                # 响应里「预计送达」字段路径
KB_ORDER_TEST_ID=TEST123             # 自检用订单号（check_adapters.py）

# ---- 库存适配器 ----
KB_INVENTORY_API_URL=       # 基址，如 http://inv-svc.internal
KB_INVENTORY_PATH_TPL=/inventory/{sku}   # 路径模板，{sku} 替换为 SKU
KB_INVENTORY_STOCK_PATH=stock           # 响应里「库存数量」字段路径
KB_INVENTORY_WAREHOUSE_PATH=warehouse  # 响应里「仓库」字段路径
KB_INVENTORY_TEST_SKU=SKU-TEST         # 自检用 SKU

# 新增后端（CRM / 工单系统等）：继承 APIAdapter 写 call()+_mock()，在 adapters.build_registry 注册。

# ===== 合成开关（P5）=====
# 1/true 启用本地 LLM 合成（KB_LLM_BASE_URL 需可达）；失败自动回退模板合成
KB_LLM_ENABLED=0

# ===== Web 控制台加固（P5）=====
# 非空则 /api/* 需 Authorization: Bearer <token>（或 ?token=）；空=不鉴权
KB_API_TOKEN=
# 每 IP 每分钟最大请求数；0=不限流
KB_RATE_LIMIT=0
# 结构化访问日志文件路径；空=仅打印到 stdout
KB_LOG_FILE=
